{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "regex": "^(.*)$",
        "destination": "https://ollyofc.vercel.app/:1",
        "type": 301
      }
    ]
  }
}
