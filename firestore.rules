rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role in ['admin', 'moderator'];
    }

    function isStaffUserFieldsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'email', 'position', 'isActive', 'photoURL', 'updatedAt']);
    }

    // Finishing or editing a game rewrites career totals for everyone who played.
    // statGames may still be deleted from older user documents.
    function isPlayerStatsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stats', 'statGames', 'updatedAt']);
    }

    function isStaffUserCreate() {
      return request.resource.data.role == 'user'
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.isActive == true
        && request.resource.data.position is string;
    }

    match /users/{userId} {
      // Public squad list: guests can list every user document.
      allow get, list: if true;

      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && isStaffUserCreate()
      ) || (
        isStaff() && isStaffUserCreate()
      );

      allow update: if (
        isAdmin()
        && (request.auth.uid != userId || request.resource.data.role == resource.data.role)
      ) || (
        isStaff() && isStaffUserFieldsUpdate()
      ) || (
        isStaff() && isPlayerStatsUpdate()
      ) || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.position is string
        && request.resource.data.isActive is bool
      );

      allow delete: if isAdmin();

      match /fcmTokens/{tokenId} {
        allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /{path=**}/fcmTokens/{tokenId} {
      allow read: if isAdmin();
    }

    function isVisitorId(value) {
      return value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
    }

    function isDayKey(value) {
      return value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /visitorSessions/{visitorId} {
      allow create, update: if isVisitorId(visitorId)
        && request.resource.data.visitorId == visitorId;
      allow read, delete: if isAdmin();
    }

    match /visitorDays/{day} {
      allow create, update: if isDayKey(day);
      allow read, delete: if isAdmin();

      match /visitors/{visitorId} {
        allow create, update: if isVisitorId(visitorId)
          && request.resource.data.visitorId == visitorId;
        allow read, delete: if isAdmin();
      }
    }

    // The verifier is stored on that game, so one game does not share another's.
    function isGamePaymentVerifier(gameId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/games/$(gameId)).data.get('paymentVerifierId', '') == request.auth.uid;
    }

    function touchesPaymentFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['paymentStatus', 'transactionId', 'paymentSubmittedAt', 'paid', 'paidAt', 'paidBy']);
    }

    // Paid is allowed with no earlier submission. The player does not have to tap Pay.
    function isPaymentReviewUpdate(gameId) {
      return (isAdmin() || isGamePaymentVerifier(gameId))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'paid', 'paidAt', 'paidBy'])
        && request.resource.data.paymentStatus in ['paid', 'cancelled']
        && request.resource.data.paidBy == request.auth.uid
        && request.resource.data.paidAt is timestamp;
    }

    // A player may submit their own transaction ID, which stays pending.
    // They cannot set paid or cancelled.
    function isOwnParticipantPaymentSubmit(participantId) {
      return isSignedIn()
        && request.auth.uid == participantId
        && resource.data.get('kind', 'user') != 'guest'
        && (
          (
            !resource.data.keys().hasAny(['paymentStatus'])
            && resource.data.get('paid', false) != true
          ) || resource.data.get('paymentStatus', '') == 'cancelled'
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'transactionId', 'paymentSubmittedAt'])
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() >= 5
        && request.resource.data.transactionId.size() <= 120
        && request.resource.data.paymentSubmittedAt is timestamp;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if isStaff();
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentVerifierId'])
        || (
          isStaff()
          && (
            !request.resource.data.keys().hasAny(['paymentVerifierId'])
            || (
              request.resource.data.paymentVerifierId is string
              && request.resource.data.paymentVerifierId.size() > 0
              && exists(/databases/$(database)/documents/users/$(request.resource.data.paymentVerifierId))
            )
          )
        )
      );
      allow delete: if isAdmin();

      match /participants/{participantId} {
        allow read: if true;

        allow create: if isSignedIn() && (
          isStaff() || (
            request.auth.uid == participantId
            && request.resource.data.get('kind', 'user') != 'guest'
          )
        );

        allow update: if isOwnParticipantPaymentSubmit(participantId)
          || isPaymentReviewUpdate(gameId)
          || (isStaff() && !touchesPaymentFields());

        allow delete: if isSignedIn() && (
          isStaff() || request.auth.uid == participantId
        );
      }
    }
  }
}
