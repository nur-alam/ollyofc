# Production (Vercel / .env)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key

# Server only (Vercel). Used to send FCM when a game is created.
# Paste the full service-account JSON as one line. Do not wrap it in extra quotes.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# or:
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@....iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Same random string on Vercel and Cloudflare Workers.
# Used to send the 1-hour kickoff reminder. Do not put this in VITE_ variables.
# CRON_SECRET=a-long-random-string

# Slack app signing secret (Basic Information). Verifies slash commands and button clicks.
# /ollyofc-leaderboard → https://ollyofc.vercel.app/api/slack/leaderboard
# /ollyofc-games → https://ollyofc.vercel.app/api/slack/games
# /ollyofc-squad → https://ollyofc.vercel.app/api/slack/squad
# Interactivity Request URL → https://ollyofc.vercel.app/api/slack/actions
# SLACK_SIGNING_SECRET=your_slack_signing_secret

# Same project locally. pnpm dev uses Firestore database "ollyofcdev".
# pnpm prod and production builds use "(default)".
